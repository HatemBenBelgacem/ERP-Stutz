# Verbindung zur PostgreSQL-Datenbank (Datenbank vorher anlegen: createdb erp_stutz)
DATABASE_URL=postgres://postgres:PASSWORT@localhost:5432/erp_stutz

# Optional: Nur diese E-Mail wird beim Registrieren Administrator
# ADMIN_EMAIL=name@example.com

# Optional: Anmeldung mit Microsoft (App-Registrierung in Microsoft Entra ID)
# Redirect-URI dort eintragen: <APP_URL>/auth/microsoft/callback
# APP_URL=http://localhost:3000
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
